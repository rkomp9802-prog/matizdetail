# --- Этап 2: Gemini ---
# Ключ из Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Необязательно — по умолчанию gemini-2.5-flash
GEMINI_MODEL=

# --- Этап 3: база вопросов и переписки ---
# Локальная разработка: file:local.db (токен не нужен)
# Облако Turso: libsql://<имя-базы>-<аккаунт>.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Админка ---
ADMIN_PASSWORD=

# --- Уведомления в Telegram (необязательно) ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Куда слать: свой id можно узнать у @userinfobot, для группы id отрицательный
TELEGRAM_CHAT_ID=
# Придумайте любую строку — ею подписываются запросы от Telegram
TELEGRAM_WEBHOOK_SECRET=

# --- Передача заявок в CRM (необязательно) ---
# Локально: http://localhost:3001/api/public/leads
# На проде CRM должна быть доступна по публичному адресу
CRM_LEADS_URL=
CRM_API_KEY=
